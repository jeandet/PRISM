# Prebuilt wgpu-native (WebGPU, standard webgpu.h) for macos-aarch64. Not a wrapdb wrap: `meson wrap
# update` does not touch it. To bump: change the tag in source_url/source_filename and the
# directory, and take source_hash from the release's asset digest
# (gh api repos/gfx-rs/wgpu-native/releases/tags/<tag> --jq '.assets[] | .name, .digest').
[wrap-file]
directory = wgpu-native-macos-aarch64-v29.0.1.1
source_url = https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-macos-aarch64-release.zip
source_filename = wgpu-macos-aarch64-release-v29.0.1.1.zip
source_hash = a5797a37b1adf720bcd5dcffb291edbbd5b7b14be0a3874c28e6393a655a7a3e
lead_directory_missing = true
patch_directory = wgpu-native
