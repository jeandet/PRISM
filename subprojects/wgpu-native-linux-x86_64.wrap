# Prebuilt wgpu-native (WebGPU, standard webgpu.h) for linux-x86_64. Not a wrapdb wrap: `meson wrap
# update` does not touch it. To bump: change the tag in source_url/source_filename and the
# directory, and take source_hash from the release's asset digest
# (gh api repos/gfx-rs/wgpu-native/releases/tags/<tag> --jq '.assets[] | .name, .digest').
[wrap-file]
directory = wgpu-native-linux-x86_64-v29.0.1.1
source_url = https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-linux-x86_64-release.zip
source_filename = wgpu-linux-x86_64-release-v29.0.1.1.zip
source_hash = 95a4d90c071005a98d03eab348beaa6b07e16eb00d1dcdb9f8348f75eb97ec5a
lead_directory_missing = true
patch_directory = wgpu-native
