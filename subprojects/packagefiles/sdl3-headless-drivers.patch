--- a/src/video/meson.build
+++ b/src/video/meson.build
@@ -1,5 +1,12 @@
 subdir('yuv2rgb')
 
+# PRISM: the headless video drivers, for pixel tests and CI without a display
+# (SDL_VIDEODRIVER=offscreen). The wrapdb port ships their meson.build but never uses them.
+cdata.set('SDL_VIDEO_DRIVER_OFFSCREEN', 1)
+subdir('offscreen')
+cdata.set('SDL_VIDEO_DRIVER_DUMMY', 1)
+subdir('dummy')
+
 if host_machine.system() == 'windows'
   cdata.set('SDL_VIDEO_DRIVER_WINDOWS', 1)
   subdir('windows')
--- a/src/audio/meson.build
+++ b/src/audio/meson.build
@@ -1,3 +1,8 @@
+# PRISM: the dummy audio driver, for audio tests and CI without a sound card
+# (SDL_AUDIO_DRIVER=dummy).
+cdata.set('SDL_AUDIO_DRIVER_DUMMY', 1)
+subdir('dummy')
+
 if host_machine.system() == 'windows'
   cdata.set('SDL_AUDIO_DRIVER_DSOUND', 1)
   #  cdata.set('SDL_AUDIO_DRIVER_WASAPI', 1)
--- a/meson.build
+++ b/meson.build
@@ -74,6 +74,12 @@
   define = i[1]
   cdata.set10(define, cc.has_header(hname))
 endforeach
+
+# PRISM: the compiler's atomic builtins, as SDL's CMake build detects them. The WrapDB port left
+# that check as a comment, so SDL emulated every atomic with a spinlock.
+if cc.get_id() in ['gcc', 'clang']
+  cdata.set('HAVE_GCC_ATOMICS', 1)
+endif
 
 check_functions = [
   # check token ['HAVE_GCC_ATOMICS']
@@ -287,6 +293,8 @@
   # ideally this should have a check for compile like the cmake configuration, see sdlchecks.cmake
   cdata.set('SDL_PLATFORM_LINUX', 1)
   cdata.set('SDL_THREAD_PTHREAD', 1)
+  # PRISM: real recursive mutexes, as SDL's CMake build and the macOS branch here have.
+  cdata.set('SDL_THREAD_PTHREAD_RECURSIVE_MUTEX', 1)
   cdata.set('HAVE_STRLEN', 1)
   cdata.set('SDL_LOADSO_DLOPEN', 1)
   cdata.set('SDL_PROCESS_POSIX', 1)
